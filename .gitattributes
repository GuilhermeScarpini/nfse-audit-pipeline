# Normalize line endings: text files are always stored and checked out with LF,
# so shell scripts and configs work inside Linux containers.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch line endings or try to diff
*.xlsx binary
*.pdf binary
*.png binary

# Official schemas are kept byte-for-byte so their hashes match the published package
src/nfse_audit/extraction/schemas/** -text
